# Copy to .env and replace placeholders. Do not commit .env.
# SQL Server SA password must meet SQL complexity rules (upper, lower, number, symbol; length >= 8).
MSSQL_SA_PASSWORD=ChangeMe_StrongP@ssw0rd

# HMAC signing key for JWT (minimum 32 characters).
JWT_KEY=change-me-to-a-long-random-secret-key

# Optional host port mappings
API_HOST_PORT=8080
SQL_HOST_PORT=1433
